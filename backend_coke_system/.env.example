# Local development without Docker. Copy this file to backend_coke_system/.env.
# Docker uses the root .env through compose.yaml instead; this file is
# gitignored and excluded from the backend image build context.
DEBUG=true
SECRET_KEY=django-insecure-dev-only
DB_NAME=cokedb7
DB_USER=root
DB_PASSWORD=CHANGE_ME_local_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
# Print emails (approval, password reset) to the runserver console instead of SMTP
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Testing from a phone on the LAN? Add addresses like:
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.10
# CORS_ALLOWED_ORIGINS=http://192.168.1.10:3000
