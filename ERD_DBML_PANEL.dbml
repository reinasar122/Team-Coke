// Team-Coke Van Load Tracking App ERD
// Recommended for panel/client presentation in dbdiagram.io.
// This is a simplified conceptual ERD focused on the agent app workflow.

Project team_coke_vanload_app {
  database_type: 'MySQL'
}

Enum van_load_status {
  pending
  in_progress
  synced
  completed
}

Table warehouses {
  id int [pk, increment]
  name varchar(255)
  city varchar(100)
  region varchar(100)
  street_address varchar(255)
  phone_number varchar(11)
}

Table users {
  id int [pk, increment]
  warehouse_id int
  first_name varchar(100)
  last_name varchar(100)
  phone_number varchar(15)
  email varchar(255)
  role_name varchar(50)
  is_active boolean
}

Table vans {
  id int [pk, increment]
  warehouse_id int
  van_id varchar(50)
  plate_number varchar(20)
}

Table routes {
  id int [pk, increment]
  warehouse_id int
  route_name varchar(100)
}

Table products {
  id int [pk, increment]
  warehouse_id int
  product_name varchar(255)
  system_code varchar(100)
  unit_label varchar(50)
  content_no int
  selling_price decimal(12,2)
  bottle_price decimal(12,2)
  shell_price decimal(12,2)
  is_returnable boolean
}

Table stocks {
  id int [pk, increment]
  warehouse_id int
  product_id int
  quantity_available int
  last_updated datetime
}

Table van_load_transactions {
  id int [pk, increment]
  warehouse_id int
  route_id int
  van_id int
  agent_user_id int
  msp_no varchar(20)
  load_date datetime
  expected_sale decimal(12,2)
  actual_sale decimal(12,2)
  discrepancy_empty decimal(12,2)
  discrepancy_non_empty decimal(12,2)
  empties_price_total decimal(12,2)
  empty_returns decimal(12,2)
  returned_with_content decimal(12,2)
  total_expenses decimal(12,2)
  payment_method varchar(50)
  status van_load_status
  remarks text
}

Table van_load_items {
  id int [pk, increment]
  van_load_id int
  product_id int
  dispatched_pcs int
  dispatched_shell int
  sold_pcs int
  sold_shell int
  empty_return_pcs int
  empty_return_shell int
  actual_return_pcs int
  actual_return_shell int
  discrepancy_empties_pc int
  discrepancy_empties_shell int
  discrepancy_full_pcs int
  discrepancy_full_shell int
  discount_percent decimal(5,2)
  expected_sale decimal(12,2)
  actual_sale decimal(12,2)
}

Table expense_items {
  id int [pk, increment]
  van_load_id int
  description varchar(255)
  amount decimal(12,2)
  notes varchar(255)
}

Table payments {
  id int [pk, increment]
  van_load_id int
  amount decimal(12,2)
  method varchar(50)
  date_paid datetime
  reference_no varchar(100)
}

Table returnable_stocks {
  id int [pk, increment]
  warehouse_id int
  product_id int
  empty_bottle_qty int
  empty_shell_qty int
  last_updated datetime
}

Ref: users.warehouse_id > warehouses.id
Ref: vans.warehouse_id > warehouses.id
Ref: routes.warehouse_id > warehouses.id
Ref: products.warehouse_id > warehouses.id
Ref: stocks.warehouse_id > warehouses.id
Ref: stocks.product_id > products.id

Ref: van_load_transactions.warehouse_id > warehouses.id
Ref: van_load_transactions.route_id > routes.id
Ref: van_load_transactions.van_id > vans.id
Ref: van_load_transactions.agent_user_id > users.id

Ref: van_load_items.van_load_id > van_load_transactions.id
Ref: van_load_items.product_id > products.id

Ref: expense_items.van_load_id > van_load_transactions.id
Ref: payments.van_load_id > van_load_transactions.id

Ref: returnable_stocks.warehouse_id > warehouses.id
Ref: returnable_stocks.product_id > products.id
