# ---- Images and deploy metadata ----
IMAGE_NAMESPACE=local
IMAGE_TAG=replace-with-git-sha
DEPLOY_ENV=production
NGINX_PORT=8080
PYTHON_IMAGE_TAG=3.12-slim-bookworm
NODE_IMAGE_TAG=22-bookworm-slim
NGINX_IMAGE_TAG=1.27.5-alpine
MYSQL_IMAGE_TAG=8.4

# ---- Database ----
MYSQL_DATABASE=cokedb7
MYSQL_USER=coke
MYSQL_PASSWORD=CHANGE_ME_database_password # secret: password for MYSQL_USER
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password # secret: MySQL root password

# ---- Django and HTTP ----
DEBUG=false
SECRET_KEY=CHANGE_ME_django_secret # secret: Django signing key, 50+ chars in production
ALLOWED_HOSTS=example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
CORS_ALLOW_ALL_ORIGINS=false

# ---- Email ----
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-account@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_gmail_app_password # secret: SMTP app password for EMAIL_HOST_USER
DEFAULT_FROM_EMAIL=your-account@gmail.com

# ---- Backups and deployment state ----
BACKUP_RETENTION_DAYS=14
BACKUP_MIN_FREE_GB=5
BACKUP_DIR=backups
DEPLOYMENT_DIR=deployments
