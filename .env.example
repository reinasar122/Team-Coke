DEPLOY_ENV=production
NGINX_PORT=8080
PYTHON_IMAGE_TAG=3.12-slim-bookworm
NODE_IMAGE_TAG=22-bookworm-slim
NGINX_IMAGE_TAG=1.27.5-alpine
MYSQL_IMAGE_TAG=8.4
MYSQL_DATABASE=cokedb7
MYSQL_USER=coke
MYSQL_PASSWORD=CHANGE_ME_database_password
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
SECRET_KEY=CHANGE_ME_django_secret
DEBUG=false
ALLOWED_HOSTS=example.com
CORS_ALLOWED_ORIGINS=https://example.com
CSRF_TRUSTED_ORIGINS=https://example.com
