// Team-Coke Core ERD
// Use this in dbdiagram.io when you want a schema closer to the current backend structure.

Project team_coke_core {
  database_type: 'MySQL'
}

Enum merchandising_status {
  pending
  reserved
  complete
  cancelled
}

Enum returnable_source {
  customer
  supplier
}

Enum credit_status {
  pending
  partial
  paid
}

Table warehouses {
  id int [pk, increment]
  name varchar(255)
  country varchar(100)
  region varchar(100)
  province varchar(100)
  city varchar(100)
  barangay varchar(255)
  street_address varchar(255)
  zip_code varchar(4)
  phone_number varchar(11)
  email varchar(255)
}

Table roles {
  id int [pk, increment]
  name varchar(50)
}

Table users {
  id int [pk, increment]
  role_id int
  warehouse_id int
  email varchar(255)
  password varchar(255)
  first_name varchar(100)
  last_name varchar(100)
  gender varchar(10)
  phone_number varchar(15)
  is_active boolean
  must_change_password boolean
  status varchar(20)
  otp varchar(6)
  otp_required boolean
  is_approved boolean
  otp_expiry datetime
  created_at datetime
  last_login datetime
}

Table suppliers {
  id int [pk, increment]
  company_name varchar(255)
  registration_number varchar(20)
  bir_no varchar(100)
  contact_person varchar(255)
  email varchar(255)
  phone_number varchar(11)
  country varchar(100)
  region varchar(100)
  province varchar(100)
  city varchar(100)
  barangay varchar(255)
  street_address varchar(255)
  zip_code varchar(4)
}

Table vans {
  id int [pk, increment]
  warehouse_id int
  van_id varchar(50)
  plate_number varchar(20)
  created_at datetime
  updated_at datetime
}

Table routes {
  id int [pk, increment]
  warehouse_id int
  route_name varchar(100)
}

Table product_categories {
  id int [pk, increment]
  name varchar(100)
}

Table unit_types {
  id int [pk, increment]
  content_no int
  returnable boolean
  content_returnable boolean
}

Table pricings {
  id int [pk, increment]
  purchase_price decimal(12,2)
  selling_price decimal(12,2)
  shell_price decimal(12,2)
  bottle_price decimal(12,2)
}

Table products {
  id int [pk, increment]
  supplier_id int
  product_category_id int
  unit_type_id int
  price_id int
  warehouse_id int
  system_code varchar(100)
  supplier_code varchar(100)
  product_name varchar(255)
  image varchar(255)
}

Table stocks {
  id int [pk, increment]
  product_id int
  warehouse_id int
  quantity_available int
  last_updated datetime
}

Table customers {
  id int [pk, increment]
  warehouse_id int
  name varchar(255)
  address varchar(255)
  phone varchar(20)
}

Table receivings {
  id int [pk, increment]
  supplier_id int
  warehouse_id int
  receive_no varchar(20)
  date_time datetime
  invoice_no varchar(100)
  return_total_amount decimal(12,2)
  receive_total_amount decimal(12,2)
  net_amount decimal(12,2)
  received_by varchar(100)
  remarks text
}

Table receiving_items {
  id int [pk, increment]
  receiving_id int
  product_id int
  product_name varchar(255)
  pcs_qty int
  shell_qty int
  bottle_qty int
  bad_order_pcs int
  unit_price decimal(12,2)
  shell_price decimal(12,2)
  bottle_price decimal(12,2)
  unit_cost decimal(12,2)
  total decimal(12,2)
}

Table transaction_types {
  id int [pk, increment]
  name varchar(100)
}

Table merchandisings {
  id int [pk, increment]
  transaction_type_id int
  warehouse_id int
  route_id int
  van_id int
  customer_id int
  msp_no varchar(20)
  handled_by varchar(100)
  date_time datetime
  expected_sale decimal(12,2)
  actual_sale decimal(12,2)
  discrepancy_non_empty decimal(12,2)
  discrepancy_empty decimal(12,2)
  miscellaneous decimal(12,2)
  payment_amount decimal(12,2)
  payment_method varchar(50)
  invoice_no varchar(20)
  status merchandising_status
  reserved_date date
  remarks text
  returned_with_content decimal(12,2)
  empties_price_total decimal(12,2)
  empty_returns decimal(12,2)
  total_amount decimal(12,2)
  cash_received decimal(12,2)
  change decimal(12,2)
  full_returns_applied boolean
}

Table merchandising_items {
  id int [pk, increment]
  merchandising_id int
  product_id int
  dispatched_pcs int
  dispatched_shell int
  selling_price decimal(12,2)
  sold_pcs int
  sold_shell int
  empty_price_shell decimal(12,2)
  empty_price_pc decimal(12,2)
  empty_return_pcs int
  empty_return_shell int
  discrepancy_empties_pc int
  discrepancy_empties_shell int
  actual_return_pcs int
  actual_return_shell int
  discrepancy_full_pcs int
  discrepancy_full_shell int
  discount_percent decimal(5,2)
  expected_sale decimal(12,2)
  actual_sale decimal(12,2)
}

Table miscellaneous_items {
  id int [pk, increment]
  merchandising_id int
  description varchar(255)
  amount decimal(12,2)
  receipt_file varchar(255)
  notes varchar(255)
  created_at datetime
  updated_at datetime
}

Table payments {
  id int [pk, increment]
  merchandising_id int
  amount decimal(12,2)
  method varchar(50)
  date_paid datetime
  reference_no varchar(100)
}

Table returnable_stocks {
  id int [pk, increment]
  product_id int
  warehouse_id int
  supplier_id int
  empty_bottle_qty int
  empty_shell_qty int
  source returnable_source
  last_updated datetime
}

Table credit_ledgers {
  id int [pk, increment]
  merchandising_id int
  warehouse_id int
  msp_no varchar(100)
  customer_name varchar(255)
  total_amount decimal(12,2)
  amount_paid decimal(12,2)
  due_date date
  status credit_status
  created_at datetime
}

Table credit_payments {
  id int [pk, increment]
  credit_id int
  amount decimal(12,2)
  method varchar(20)
  note varchar(255)
  created_at datetime
  recorded_by varchar(255)
}

Ref: users.role_id > roles.id
Ref: users.warehouse_id > warehouses.id

Ref: vans.warehouse_id > warehouses.id
Ref: routes.warehouse_id > warehouses.id

Ref: products.supplier_id > suppliers.id
Ref: products.product_category_id > product_categories.id
Ref: products.unit_type_id > unit_types.id
Ref: products.price_id > pricings.id
Ref: products.warehouse_id > warehouses.id

Ref: stocks.product_id > products.id
Ref: stocks.warehouse_id > warehouses.id

Ref: customers.warehouse_id > warehouses.id

Ref: receivings.supplier_id > suppliers.id
Ref: receivings.warehouse_id > warehouses.id
Ref: receiving_items.receiving_id > receivings.id
Ref: receiving_items.product_id > products.id

Ref: merchandisings.transaction_type_id > transaction_types.id
Ref: merchandisings.warehouse_id > warehouses.id
Ref: merchandisings.route_id > routes.id
Ref: merchandisings.van_id > vans.id
Ref: merchandisings.customer_id > customers.id

Ref: merchandising_items.merchandising_id > merchandisings.id
Ref: merchandising_items.product_id > products.id

Ref: miscellaneous_items.merchandising_id > merchandisings.id
Ref: payments.merchandising_id > merchandisings.id

Ref: returnable_stocks.product_id > products.id
Ref: returnable_stocks.warehouse_id > warehouses.id
Ref: returnable_stocks.supplier_id > suppliers.id

Ref: credit_ledgers.merchandising_id > merchandisings.id
Ref: credit_ledgers.warehouse_id > warehouses.id
Ref: credit_payments.credit_id > credit_ledgers.id
